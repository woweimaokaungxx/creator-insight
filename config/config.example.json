# creator-insight 配置文件模板
# 复制为 config/config.json 后填写
{
  "app": {
    "host": "127.0.0.1",
    "port": 8781,
    "data_dir": "./data",
    "log_level": "INFO"
  },
  "ai": {
    "cloud": {
      "provider": "openai-compatible",
      "api_key": "",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-flash",
      "_cloud_note": "云端大模型（OpenAI 兼容协议 + Bearer 鉴权 + 流式 + json_object）。可替换为任意兼容服务，例如小米 MiMo：base_url 改 https://api.xiaomimimo.com/v1、model 改 mimo-v2.5（或 mimo-v2.5-pro），api_key 填控制台申请的 sk- 开头 Key",
      "max_tokens": 16384,
      "chat_template_kwargs": {}
    },
    "local_fallback": {
      "enabled": false,
      "provider": "ollama",
      "base_url": "http://127.0.0.1:11434",
      "model": "qwen2.5:7b-instruct-q4_K_M",
      "_model_note": "本地 LLM 兜底。需先本地跑 Ollama：ollama pull qwen2.5:7b。可选：qwen2.5:3b/7b/14b、deepseek-r1:7b、llama3.1:8b 等"
    },
    "task_model_map": {
      "summarize": "cloud",
      "extract_claim": "cloud",
      "extract_prediction": "cloud",
      "parse_time": "cloud",
      "verify": "cloud",
      "simplify": "cloud"
    },
    "daily_call_limit": 0,
    "_daily_call_limit_note": "每日 AI 调用上限（0=不限）。达到上限后 AI 调用被拒绝，用于成本控制（docs/14 风险#14）。计数存 data/ai_usage.json，跨日自动归零",
    "daily_call_warn": 0,
    "_daily_call_warn_note": "AI 用量告警阈值（0=不告警）。当日调用达到该次数时推送一条通知"
  },
  "search": {
    "provider": "tavily",
    "tavily_api_key": "",
    "fallback": "bing",
    "max_results": 5
  },
  "market_data": {
    "cn": "akshare",
    "us": "yfinance"
  },
  "transcription": {
    "prefer": "platform_subtitle",
    "defaultProvider": "whisper",
    "_provider_note": "本地转写通道：whisper（本地 faster-whisper）。参考 douyin-creator-distill",
    "whisper": {
      "model": "small",
      "_model_note": "Whisper 模型档位：tiny(最快~39M)/base(~74M)/small(~244M,推荐平衡)/medium(~769M,更准)/large-v3(最准~1.5G)。首次运行自动下载，路径可设 HF_HOME 或下载到本地缓存",
      "device": "auto",
      "_device_note": "cpu（通用）/ auto（自动探测 GPU）/ cuda（强制 NVIDIA GPU，实测约 4 倍于 CPU）。选 cuda/auto 且未装系统级 CUDA Toolkit 时，用 pip 装运行时库即可：pip install nvidia-cublas-cu12 nvidia-cudnn-cu12 nvidia-cuda-runtime-cu12（程序会自动把 site-packages/nvidia/*/bin 注入 DLL 搜索路径，无需手工配 PATH）。显存参考：small 约 1GB / medium 约 2GB / large-v3 约 4GB+",
      "compute_type": "int8",
      "_compute_type_note": "CPU 用 int8（最快）；GPU 用 float16（推荐）；更高精度可用 float32",
      "batch_size": 16,
      "_batch_size_note": "批量推理批大小（faster-whisper BatchedInferencePipeline）：批处理代替逐段串行，吞吐提升数倍、GPU 可打满。0=关闭（回退逐段模式）。实测 RTX 2060 + small：16 → 约 39x 实时、GPU 峰值 99%；24+beam1 → 约 85x（时间戳粒度更粗、准确率略降）。显存不足时调小或设 0",
      "language": "",
      "_language_note": "可选 zh / en，留空则自动检测",
      "retain_media": false,
      "_retain_media_note": "false 则转写后删除中间音频（保留原始视频）"
    },
    "artifacts_dir": "./data/transcripts/whisper",
    "_artifacts_note": "本地转写产物（正文 md / 逐段 json / 字幕 srt）落盘目录"
  },
  "platforms": {
    "douyin": {
      "enabled": true
    },
    "bilibili": {
      "enabled": true,
      "cookie": "",
      "_cookie_note": "可选：B 站登录后的 Cookie（'k1=v1; k2=v2'，至少含 SESSDATA）。留空时单视频元数据一般仍可用，但 CC 字幕与 UP 主投稿目录容易遇到风控（-352 / -412）。可在前端「系统设置」页的「平台」分组填写",
      "fetch_video_stats": false,
      "_fetch_video_stats_note": "抓取 UP 主投稿目录时是否逐条补全点赞/转发/收藏（显著变慢，带 0.3s 限速）；false 时批量结果只含评论数"
    }
  },
  "obsidian": {
    "vault_path": "",
    "root_folder": "creator-insight",
    "write_enabled": false,
    "sync_predictions": true,
    "sync_verifications": true
  },
  "verification": {
    "auto_apply": true,
    "auto_apply_min_confidence": 0.85,
    "auto_apply_undo_hours": 24,
    "human_review_required": true,
    "sample_size_threshold": 30,
    "scheduler_enabled": true,
    "scheduler_interval_sec": 3600
  },
  "account": {
    "enabled": true,
    "_enabled_note": "抖音账号与登录态功能开关（前端「自动监控」页 → 抖音账号与登录态卡片）。关闭后 /api/account/login 会拒绝启动登录窗口",
    "login_timeout_sec": 900,
    "_login_timeout_note": "打开登录窗口后等待扫码的超时秒数（默认 900 = 15 分钟），超时后窗口自动关闭并标记为已超时",
    "default_profile_dir": "",
    "_default_profile_dir_note": "登录态浏览器目录；留空则使用 data/browser_profile/douyin。登录成功后该目录会自动写入 monitor.profile_path，供目录抓取复用",
    "_note": "登录会在本机打开可见浏览器窗口扫码；登录态保存到专用 Chrome 目录，并导出 Cookie 到 data/cookies/douyin_login.txt。二者均含登录凭据，不进入 Git"
  },
  "monitor": {
    "enabled": true,
    "max_pages": 20,
    "per_page": 18,
    "douyin_cookie": "",
    "_douyin_cookie_note": "可选：抖音登录后的 cookie（'k1=v1; k2=v2'）。可在前端「自动监控」页的账号卡片手动写入，无需手改本文件；留空时 adapter 会自动用 playwright 驱动系统 Chrome/Edge 生成匿名 cookie（需已安装 playwright）",
    "profile_path": "",
    "_profile_path_note": "可选：已登录抖音的 Chrome user-data-dir（参考 douyin-creator-distill）。可点击前端账号卡片的「打开登录窗口」自动写入。批量抓取博主目录被 a_bogus 风控时，用该登录态 profile 通过 Playwright 拦截目录 API 抓取。示例：C:/Users/xxx/AppData/Local/Google/Chrome/User Data/DouyinScraper"
  },
  "notify": {
    "enabled": true,
    "channels": ["local"],
    "webhook_url": "",
    "_webhook_note": "可选：每个触发事件会向该地址 POST {title, body, category, payload, sent_at}",
    "smtp": {
      "host": "",
      "port": 465,
      "user": "",
      "password": "",
      "from_name": "creator-insight",
      "to": "",
      "use_ssl": true
    }
  },
  "semantic_search": {
    "enabled": true,
    "active_model": "high_precision",
    "model_root": "./data/models/embedding",
    "source": "modelscope",
    "model_path": "",
    "_model_path_note": "本地 embedding 模型目录（sentence-transformers 兼容，含 model.safetensors）。可指向 douyin-creator-distill 的 runtime/models/embedding/high_precision",
    "model_id": "high_precision",
    "dimension": 1024,
    "device": "cpu",
    "batch_size": 16,
    "_note": "本地语义检索（参考 douyin-creator-distill）：可选轻量/高精度模型；embedder 走本地 sentence-transformers 离线推理，生成向量用于智能检索"
  }
}
